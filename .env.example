# Copia este archivo a .env y completa SOLO la clave del proveedor que vayas a usar.
# Sin ninguna clave, el agente arranca en modo determinista (mismas herramientas, sin LLM).

# auto | anthropic | openai | gemini | local
# auto = el primero con clave (anthropic → openai → gemini). Si pides uno sin clave, se usa otro que sí la tenga.
LLM_PROVIDER=auto

# Basta con UNA. Cambiar de proveedor = cambiar la clave; no se toca código.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Opcional: modelo por proveedor. Por defecto: claude-opus-5-5 | gpt-4.1-mini | gemini-2.5-flash
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
# Opcional: modelo genérico; solo se aplica si corresponde al proveedor activo (claude-*, gemini-*, resto → OpenAI)
LLM_MODEL=
# Opcional (solo Anthropic): low | medium | high | xhigh | max
LLM_EFFORT=low
# Opcional: endpoint compatible con OpenAI (Azure, proxy corporativo…)
OPENAI_BASE_URL=

# Tiempo máximo por llamada al proveedor (ms)
LLM_TIMEOUT_MS=45000
# CA1: tope de iteraciones modelo → herramientas por turno
MAX_ITERACIONES=25
# Tope de tokens (entrada + salida) por sesión
MAX_TOKENS_SESION=300000

PORT=3000
# Opcional: si se define, /api/* y /out/* exigen la cabecera x-access-key (el front la pide)
ACCESS_KEY=

# Opcional: fija la "fecha de ejecución" (YYYY-MM-DD) para evaluar vigencias de soportes
FECHA_EJECUCION=
